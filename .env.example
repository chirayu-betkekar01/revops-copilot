# Template for .env. COPY it (don't rename it), then change the values:
#   Copy-Item .env.example .env
# .env is gitignored. This file is committed, so it must only ever hold placeholders.

# Postgres container settings (the official postgres image reads these three).
POSTGRES_USER=revops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=revops

# Port on YOUR laptop that maps to Postgres in the container.
# Change to 5433 if you already have a Postgres installed locally on 5432.
POSTGRES_PORT=5432

# Laptop ports for the API and dashboard. Change them if another project already uses them.
API_PORT=8000
DASHBOARD_PORT=8501

# For code running on your laptop (tests, scripts): host is localhost.
# Inside Docker, the API uses host "db" instead (docker-compose.yml builds that URL).
DATABASE_URL=postgresql://revops:change-me@localhost:5432/revops

# HubSpot service key (used from Step 2). Never commit the real one.
HUBSPOT_SERVICE_KEY=replace-me

# Step 6: the analyst agent's own read-only Postgres login (created by `just migrate`).
AGENT_DB_PASSWORD=change-me-too

# Step 6: Amazon Bedrock. Credentials come from your AWS CLI profile (`aws sso login`),
# never from this file. The model is one setting: swap it to a Claude inference profile
# (e.g. us.anthropic.claude-sonnet-5-5) once the account can use Anthropic models.
AWS_PROFILE=revops
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
